# ==============================================================================
# KONFIGURASI DATABASE CLOUD AIVEN (MYSQL / POSTGRESQL)
# ==============================================================================
# Salin konfigurasi di bawah ini ke file backend/.env Anda saat ingin
# menghubungkan aplikasi langsung ke layanan Database Cloud Aiven:

APP_NAME="Dosa dan Tobat"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Pilihan 1: Koneksi MySQL Cloud Aiven
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx-your-service-name.aivencloud.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_secure_password
DB_SSL_MODE=REQUIRED

# Jika Anda mengunduh ca.pem (Sertifikat CA Aiven), letakkan di folder backend/storage/ca.pem
# MYSQL_ATTR_SSL_CA="D:/Kerja Praktik/Laporan selama Kerja Praktik/Day-16/Dosa dan Tobat/backend/storage/ca.pem"

# Pilihan 2: Koneksi PostgreSQL Cloud Aiven (Jika menggunakan PostgreSQL di Aiven)
# DB_CONNECTION=pgsql
# DB_HOST=pg-xxxx-your-service-name.aivencloud.com
# DB_PORT=25061
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_secure_password
# DB_SSL_MODE=require
